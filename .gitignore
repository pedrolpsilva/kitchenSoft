# ==========================================
# KitchenSoft - Comprehensive .gitignore
# Technologies: Go (Golang), Next.js / Node.js, TypeScript
# ==========================================

# ------------------------------------------
# Environment & Sensitive Credentials
# ------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
serviceAccountKey*.json
**/serviceAccountKey*.json
*.lock
package-lock.json
AGENTS.md
CLAUDE.md


# ------------------------------------------
# Node.js & Frontend (Next.js / React)
# ------------------------------------------
# Dependencies
node_modules/
**/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js & Build Outputs
.next/
**/out/
**/build/
**/dist/
.swc/
.turbo/
.vercel/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Logs & Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
logs/
*.log

# ------------------------------------------
# Go (Golang) & Backend
# ------------------------------------------
# Binaries & Executables
*.exe
*.exe~
*.dll
*.so
*.dylib
server.exe
**/server.exe

# Go Test Artifacts & Coverage
*.test
*.out
coverage.*
*.coverprofile
profile.cov

# Go Workspace & Dependencies
go.work
go.work.sum
# vendor/

# ------------------------------------------
# IDEs & Code Editors
# ------------------------------------------
.idea/
.vscode/
*.swp
*.swo
*~
.zed/
.project
.classpath
.settings/

# ------------------------------------------
# Operating System Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

